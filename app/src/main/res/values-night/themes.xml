<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusBlock" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- System bars -->
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Material3 Primary Colors -->
        <item name="colorPrimary">@color/nfc_blue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">#33FFFFFF</item>
    </style>

    <style name="Theme.MyApplication" parent="Theme.FocusBlock" />
</resources>
