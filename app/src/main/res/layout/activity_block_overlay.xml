<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- Badge de Advertencia Superior -->
        <TextView
            android:id="@+id/tvOverlayModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_locked"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:text="@string/overlay_restricted_badge"
            android:textColor="@color/pastel_red_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Icono y Nombre de la Aplicación Bloqueada -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBlockedAppIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Icono de la app bloqueada"
                android:src="@drawable/ic_lock_closed"
                app:tint="@color/pastel_red_primary" />

            <TextView
                android:id="@+id/tvBlockedAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Instagram" />
        </LinearLayout>

        <!-- Contenedor del Temporizador Circular de Tiempo Restante -->
        <FrameLayout
            android:id="@+id/layoutCircularTimer"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginTop="28dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/circularTimerProgress"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:max="1000"
                android:progress="1000"
                app:indicatorColor="@color/nfc_blue_primary"
                app:indicatorSize="240dp"
                app:trackColor="#262A36"
                app:trackCornerRadius="8dp"
                app:trackThickness="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivTimerCenterIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Reloj"
                    android:src="@drawable/ic_lock_closed"
                    app:tint="@color/nfc_blue_primary" />

                <TextView
                    android:id="@+id/tvRemainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    tools:text="28:45" />

                <TextView
                    android:id="@+id/tvRemainingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/overlay_remaining_title"
                    android:textColor="#8C93A8"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Mensaje de Enfoque y Pista NFC -->
        <TextView
            android:id="@+id/tvOverlaySessionDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/overlay_session_active_desc"
            android:textColor="#9DA6BC"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutOverlayNfcHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="NFC"
                android:src="@drawable/ic_nfc"
                app:tint="@color/pastel_green_primary" />

            <TextView
                android:id="@+id/tvOverlayNfcHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/overlay_nfc_hint"
                android:textColor="@color/pastel_green_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Contenedor del Botón para Aumentar Tiempo de Enfoque (+5 min) -->
        <LinearLayout
            android:id="@+id/layoutAddTimeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayAdd5Min"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#243048"
                android:text="@string/overlay_increase_time_btn"
                android:textAllCaps="false"
                android:textColor="@color/nfc_blue_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/nfc_blue_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/overlay_cannot_decrease_hint"
                android:textColor="#6C757D"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tarjeta: Modo de Emergencia de 30s -->
        <LinearLayout
            android:id="@+id/cardOverlayEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_overlay_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_emergency_title"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/emergency_instruction"
                android:textColor="#8C93A8"
                android:textSize="12sp" />

            <!-- Barra de Progreso del Botón de Emergencia (0% a 100%) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/overlayEmergencyProgressBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:max="1000"
                android:progress="0"
                app:indicatorColor="@color/pastel_red_primary"
                app:trackColor="#2C303E"
                app:trackCornerRadius="4dp" />

            <!-- Botón Mantener Presionado 30s -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayEmergency"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/pastel_red_primary"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/overlay_emergency_hold_btn"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_timer"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Botón Salir al Inicio -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExitToHome"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/overlay_btn_exit_home"
            android:textColor="#8C93A8"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
